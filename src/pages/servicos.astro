---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import { services } from '../config/catalog';
import { whatsappLink } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Serviços"
  description="Monitoramento 24/7, pronta resposta, rastreamento de veículos, embarcações e máquinas, aplicativo e relatórios."
>
  <div class="mx-auto h-px max-w-[980px] bg-brand"></div>
  <div class="mx-auto w-full max-w-[1440px] px-gutter pt-10 pb-14 md:px-[51px]">
    <h1 class="text-center text-5xl font-bold tracking-tight text-brand md:text-[56px]">
      Serviços
    </h1>

    <ul class="mt-12 grid items-start gap-10 lg:grid-cols-2">
      {services.map((service) => (
        <li>
          <article class="flex flex-col overflow-hidden rounded-bl-[50px] rounded-br-[50px] rounded-tr-[50px] bg-brand text-white sm:flex-row">
            <Image
              src={service.photo}
              alt={service.photoAlt}
              width={620}
              height={564}
              widths={[310, 620]}
              sizes="(min-width: 640px) 310px, 100vw"
              class="h-56 w-full object-cover sm:h-[282px] sm:w-[310px] sm:shrink-0"
            />
            <div class="flex-1 p-6 sm:min-h-[282px] sm:pt-6">
              <h2 class="text-[22px] leading-[1.3] font-bold tracking-tight">{service.title}</h2>
              <p class="mt-3 text-[13px]/[19.5px] font-light">{service.description}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div class="mt-14 text-center">
      <Button
        data-reveal="rubber"
        href={whatsappLink('Olá! Gostaria de conhecer mais sobre os serviços de rastreamento.')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Tenho interesse
      </Button>
    </div>
  </div>
</BaseLayout>

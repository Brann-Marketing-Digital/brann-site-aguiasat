---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import PostMeta from '../../components/PostMeta.astro';
import Button from '../../components/Button.astro';
import { whatsappLink } from '../../config/site';
import { getSortedPosts } from '../../lib/blog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const recent = (await getSortedPosts()).filter((other) => other.id !== post.id).slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image?.src}
>
  <article class="mx-auto max-w-[820px] px-gutter py-10">
    <a href={withBase('/blog/')} class="text-sm text-brand hover:underline">
      ← Voltar ao blog
    </a>
    <h1 class="mt-6 font-display text-3xl/[1.15] font-bold tracking-tight text-brand md:text-4xl/[1.15]">
      {post.data.title}
    </h1>
    <PostMeta date={post.data.pubDate} readingTime={post.data.readingTime} class="mt-5" />

    {post.data.image && (
      <Image
        src={post.data.image}
        alt={post.data.imageAlt}
        width={1480}
        widths={[740, 1480]}
        sizes="(min-width: 820px) 740px, 100vw"
        loading="eager"
        class="mt-8 h-auto w-full"
      />
    )}

    <div class="prose-post mt-8">
      <Content />
    </div>

    {post.data.tags.length > 0 && (
      <ul class="mx-auto mt-8 flex max-w-prose flex-wrap gap-2" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li class="rounded-full border border-brand/40 px-3 py-1 text-xs text-brand">{tag}</li>
        ))}
      </ul>
    )}

    <div class="mt-12 text-center">
      <Button
        href={whatsappLink('Olá! Gostaria de fazer um orçamento de rastreamento.')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Faça seu orçamento
      </Button>
    </div>
  </article>

  {recent.length > 0 && (
    <section
      class="border-t border-neutral-200 bg-neutral-50 py-10"
      aria-labelledby="recentes-titulo"
    >
      <div class="mx-auto max-w-[820px] px-gutter">
        <h2 id="recentes-titulo" class="font-display text-xl font-bold text-brand">
          Posts recentes
        </h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-3">
          {recent.map((item) => (
            <li class="relative">
              {item.data.image && (
                <Image
                  src={item.data.image}
                  alt=""
                  width={578}
                  height={324}
                  widths={[289, 578]}
                  sizes="(min-width: 640px) 260px, 100vw"
                  class="aspect-video w-full object-cover"
                />
              )}
              <h3 class="mt-3 text-sm/[1.4] font-bold text-ink">
                <a href={withBase(`/post/${item.id}/`)} class="hover:text-brand after:absolute after:inset-0">
                  {item.data.title}
                </a>
              </h3>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

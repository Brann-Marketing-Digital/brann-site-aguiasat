---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils/url';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href?: string;
  /** pill: arredondado (header/CTAs) · square: retangular (“Saiba mais”) · white: pill branco */
  variant?: 'pill' | 'square' | 'white';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'pill', type = 'button', class: className, ...rest } = Astro.props;

const styles = {
  pill: 'rounded-full bg-brand px-8 py-2.5 text-lg tracking-[0.1em] text-white hover:bg-brand-dark',
  square: 'bg-brand px-5 py-3 text-[13px] font-bold tracking-[0.2em] text-white hover:bg-[#417586]',
  white:
    'rounded-full bg-white px-10 py-4 text-base tracking-[0.12em] text-brand-deep hover:bg-neutral-100',
} as const;

const classes = [
  'inline-flex items-center justify-center font-medium whitespace-nowrap uppercase transition-colors duration-200',
  styles[variant],
  className,
];
---

{href ? (
  <a href={withBase(href)} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}

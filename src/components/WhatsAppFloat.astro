---
import { Icon } from 'astro-icon/components';
import { site, whatsappLink } from '../config/site';

const href = whatsappLink('Olá! Gostaria de conhecer mais sobre os serviços de rastreamento.');
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Falar com a ${site.name} pelo WhatsApp`}
  class="fixed right-4 bottom-4 z-50 flex items-center gap-3 rounded-full bg-white py-2 pr-2 pl-4 text-sm text-black shadow-lg transition-transform hover:scale-[1.03] max-sm:pl-2"
>
  <span class="max-sm:hidden">Tem alguma pergunta? Contacte-nos agora</span>
  <span class="grid size-12 place-items-center rounded-full bg-[#25d366] text-white">
    <Icon name="simple-icons:whatsapp" class="size-7" />
  </span>
</a>
